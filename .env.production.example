# Copy to .env for local Docker Compose. Never commit real credentials.
MYSQL_ROOT_PASSWORD=replace-with-strong-local-root-password
AUTH_DB_NAME=shopsphere_auth
AUTH_DB_USERNAME=shopsphere_auth
AUTH_DB_PASSWORD=replace-auth-password
INVENTORY_DB_NAME=shopsphere_inventory
INVENTORY_DB_USERNAME=shopsphere_inventory
INVENTORY_DB_PASSWORD=replace-inventory-password
ORDER_DB_NAME=shopsphere_orders
ORDER_DB_USERNAME=shopsphere_orders
ORDER_DB_PASSWORD=replace-order-password
MONGO_ROOT_USERNAME=shopsphere_root
MONGO_ROOT_PASSWORD=replace-mongo-password
PRODUCT_DB_NAME=shopsphere_products
REDIS_PASSWORD=replace-redis-password
CART_TTL_HOURS=72
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=https://replace-with-your-domain
AUTH_RATE_REPLENISH=2
AUTH_RATE_BURST=5
API_RATE_REPLENISH=20
API_RATE_BURST=40
WRITE_RATE_REPLENISH=10
WRITE_RATE_BURST=20
GATEWAY_RESPONSE_TIMEOUT=10s
GHCR_OWNER=replace-with-lowercase-github-owner
IMAGE_TAG=replace-with-tested-40-character-git-sha
GRAFANA_ADMIN_PASSWORD=replace-with-random-password
