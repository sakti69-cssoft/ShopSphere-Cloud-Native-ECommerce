{
  "uid": "shopsphere",
  "title": "ShopSphere Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Service availability",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"shopsphere\"}",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / second",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95 seconds",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,instance) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gateway routes",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(routeId) (rate(spring_cloud_gateway_requests_seconds_count[5m]))",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM heap bytes",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM threads",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU usage",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "5xx / second",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Circuit breakers",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_state",
          "legendFormat": "{{instance}} {{routeId}} {{name}} {{state}}"
        }
      ]
    }
  ]
}
